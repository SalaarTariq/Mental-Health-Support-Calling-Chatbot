# =============================================================================
# CalmLink — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Twilio credentials (get from https://console.twilio.com) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# --- Default emergency contact (psychiatrist fallback number) ---
EMERGENCY_CONTACT=+1XXXXXXXXXX

# --- Groq LLM settings (get key from https://console.groq.com) ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- Backend server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
